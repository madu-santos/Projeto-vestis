# Modelo de variáveis de ambiente.
# Copie este arquivo para ".env" e ajuste os valores. O ".env" NÃO deve ser versionado.
# Ele é lido pelo Docker Compose e pela aplicação (perfil dev).

# Banco de dados (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=clothing_rental
DB_USERNAME=clothing_rental
DB_PASSWORD=troque-esta-senha

# Aplicação
SERVER_PORT=8080

# Primeira loja (usado no perfil dev para criar o estabelecimento inicial caso não exista)
STORE_NAME=Loja de Demonstracao
STORE_SLUG=loja-demo

# Primeiro administrador (usado somente no perfil dev e somente se ainda não existir nenhuma conta).
# Preencha antes da primeira execução. Depois que a conta existir, estes valores são ignorados
# e podem ser removidos; alterá-los NÃO muda a senha da conta já criada.
# ADMIN_USERNAME: nome de usuário de login (máximo 50 caracteres). Exemplo de formato: maria.silva
# ADMIN_PASSWORD: senha pessoal com no mínimo 12 caracteres. Nunca reutilize senhas reais de outros sistemas.
ADMIN_USERNAME=
ADMIN_PASSWORD=

